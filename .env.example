# Notion API integration
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Property/column names in your Notion database (must match exactly)
# Your table structure from BudgetTable-example:
#   Expense (title), Amount, Category, Comment
NOTION_TITLE_PROPERTY=Expense
NOTION_AMOUNT_PROPERTY=Amount
NOTION_MERCHANT_PROPERTY=Merchant
NOTION_DATE_PROPERTY=Date
NOTION_METHOD_PROPERTY=Payment Method
NOTION_CATEGORY_PROPERTY=Category
NOTION_TAGS_PROPERTY=Comment

# Server settings
PORT=8080